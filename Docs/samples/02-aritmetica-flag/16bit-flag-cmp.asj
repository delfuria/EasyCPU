{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// Confronto con CMP",
    "//",
    "// Cosa illustra:",
    "//   CMP sottrae senza memorizzare il risultato: aggiorna solo i flag.",
    "//",
    "// Utilizzo:",
    "//   Aprire il file e premere Avvia; in alternativa eseguire con Step Into",
    "//   un'istruzione alla volta, osservando i pannelli Registri e Memoria.",
    "//",
    "// Risultato atteso:",
    "//   AX = 5 (invariato)",
    "//   ZF = 1, SF = 0",
    "// ======================================================================",
    "",
    "        mov ax, 5",
    "        cmp ax, 5           // 5 - 5 = 0: ZF = 1, AX non cambia",
    "        stop"
  ],
  "data": []
}