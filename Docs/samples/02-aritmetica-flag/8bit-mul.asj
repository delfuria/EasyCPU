{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// Moltiplicazione a 8 bit: MUL e IMUL",
    "//",
    "// Cosa illustra:",
    "//   Con operando a 8 bit: AX = AL * sorgente.",
    "//   MUL considera i valori senza segno (0..255), IMUL con segno (-128..127).",
    "//   CF = OF = 1 se il prodotto non sta in AL (MUL) o non è l'estensione",
    "//   con segno di AL (IMUL).",
    "//",
    "// Utilizzo:",
    "//   Eseguire con Step Into: osservare AX e i flag C e O dopo ogni moltiplicazione.",
    "//",
    "// Risultato atteso:",
    "//   16 * 20 = 320: CX = 320 (uguale con MUL e IMUL)",
    "//   AL = FDh per 20: MUL dà 253 * 20 = 5060 (DX), IMUL dà -3 * 20 = -60 (AX)",
    "// ======================================================================",
    "",
    "        mov ax, 16",
    "        mov bx, 0",
    "        mov bl, 20",
    "        mul bl              // AX = 16 * 20 = 320",
    "        mov cx, ax",
    "        mov al, -3          // AL = FDh",
    "        mul bl              // senza segno: 253 * 20 = 5060",
    "        mov dx, ax",
    "        mov al, -3",
    "        imul bl             // con segno: -3 * 20 = -60",
    "        stop"
  ],
  "data": []
}