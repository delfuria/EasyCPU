{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// Divisione a 8 bit: DIV e IDIV",
    "//",
    "// Cosa illustra:",
    "//   Con operando a 8 bit: AL = AX / sorgente, AH = AX % sorgente.",
    "//   DIV considera i valori senza segno, IDIV con segno (il resto ha il",
    "//   segno del dividendo).",
    "//",
    "// Utilizzo:",
    "//   Eseguire con Step Into e osservare AH e AL.",
    "//",
    "// Risultato atteso:",
    "//   300 / 7: BX = 062Ah (AH = resto 6, AL = quoziente 42)",
    "//   250 / FEh: DIV (250 / 254) dà CX = FA00h (quoziente 0, resto 250);",
    "//   IDIV (250 / -2) dà AX = 0083h (quoziente -125, resto 0)",
    "// ======================================================================",
    "",
    "        mov ax, 300",
    "        mov cl, 7",
    "        div cl              // AL = 42, AH = 6",
    "        mov bx, ax",
    "        mov ax, 250",
    "        mov dl, 0FEh        // 254 senza segno, -2 con segno",
    "        div dl",
    "        mov cx, ax",
    "        mov ax, 250",
    "        idiv dl",
    "        stop"
  ],
  "data": []
}