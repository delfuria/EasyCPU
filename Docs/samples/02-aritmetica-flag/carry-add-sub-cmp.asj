{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// Flag di carry (CF)",
    "//",
    "// Cosa illustra:",
    "//   CF indica il riporto (ADD) o il prestito (SUB, CMP) sui numeri senza segno;",
    "//   OF indica l'overflow sui numeri con segno. STC, CLC e CMC impostano,",
    "//   azzerano e invertono CF; INC e DEC non lo modificano.",
    "//",
    "// Utilizzo:",
    "//   Eseguire con Step Into osservando i flag C e O nel pannello Registri.",
    "//",
    "// Risultato atteso:",
    "//   Dopo add ax, 1 con AX = FFFFh: AX = 0, CF = 1, OF = 0",
    "//   Dopo add bx, 1 con BX = 7FFFh: CF = 0, OF = 1",
    "//   Dopo cmp cx, 5 con CX = 3: CF = 1 (3 < 5 senza segno)",
    "//   Alla fine: CF = 1 (stc, poi inc non lo modifica)",
    "// ======================================================================",
    "",
    "        mov ax, 0FFFFh",
    "        add ax, 1           // 65535 + 1: riporto, CF = 1",
    "        mov bx, 7FFFh",
    "        add bx, 1           // 32767 + 1: overflow con segno, OF = 1",
    "        mov cx, 3",
    "        cmp cx, 5           // prestito: CF = 1",
    "        clc                 // CF = 0",
    "        cmc                 // CF = 1",
    "        clc",
    "        stc                 // CF = 1",
    "        inc cx              // INC non modifica CF",
    "        stop"
  ],
  "data": []
}