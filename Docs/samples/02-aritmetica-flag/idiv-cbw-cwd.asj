{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// Divisione con segno: CBW, CWD e IDIV",
    "//",
    "// Cosa illustra:",
    "//   IDIV divide DX:AX (o AX) con segno: prima va esteso il segno del",
    "//   dividendo con CWD (AX -> DX:AX) o CBW (AL -> AX).",
    "//   Con DIV lo stesso dividendo verrebbe letto come numero senza segno.",
    "//",
    "// Utilizzo:",
    "//   Eseguire con Step Into e osservare DX dopo CWD e AX dopo CBW.",
    "//",
    "// Risultato atteso:",
    "//   -7 / 2: SI = -3 (quoziente, copiato da AX), DX = -1 (resto)",
    "//   -20 / 3 a 8 bit: AL = -6 (FAh), AH = -2 (FEh), BX = FEFAh",
    "// ======================================================================",
    "",
    "        mov ax, -7",
    "        cwd                 // DX = FFFFh: DX:AX = -7 su 32 bit",
    "        mov cx, 2",
    "        idiv cx             // AX = -3, DX = -1",
    "        mov si, ax",
    "        mov ax, 0",
    "        mov al, -20",
    "        cbw                 // AX = -20",
    "        mov cl, 3",
    "        idiv cl             // AL = -6, AH = -2",
    "        mov bx, ax",
    "        stop"
  ],
  "data": []
}