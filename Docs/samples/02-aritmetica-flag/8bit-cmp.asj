{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// Confronto a 8 bit",
    "//",
    "// Cosa illustra:",
    "//   A 8 bit FFh vale -1: il confronto con -1 dà uguaglianza.",
    "//",
    "// Utilizzo:",
    "//   Aprire il file e premere Avvia; in alternativa eseguire con Step Into",
    "//   un'istruzione alla volta, osservando i pannelli Registri e Memoria.",
    "//",
    "// Risultato atteso:",
    "//   ZF = 1, SF = 0",
    "// ======================================================================",
    "",
    "        mov ax, 00FFh       // AL = FFh",
    "        cmp al, -1          // FFh - (-1) = 0 a 8 bit",
    "        stop"
  ],
  "data": []
}