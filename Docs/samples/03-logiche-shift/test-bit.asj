{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// Test di un bit con TEST",
    "//",
    "// Cosa illustra:",
    "//   TEST esegue un AND senza modificare l'operando: serve a controllare",
    "//   i bit. Il programma conta i bit a 1 di AX scorrendoli con SHR e",
    "//   controllando CF con JNC.",
    "//",
    "// Utilizzo:",
    "//   Aprire il file e premere Avvia; in alternativa eseguire con Step Into",
    "//   un'istruzione alla volta, osservando i pannelli Registri e Memoria.",
    "//",
    "// Risultato atteso:",
    "//   BX = 5 (bit a 1 in 00B5h = 1011 0101b)",
    "//   DX = 1 (AX è dispari)",
    "// ======================================================================",
    "",
    "        mov ax, 00B5h",
    "        mov dx, 0",
    "        test ax, 1          // bit 0 a 1? (AX non cambia)",
    "        jz pari",
    "        mov dx, 1           // dispari",
    "pari:   mov bx, 0",
    "        mov cx, 16",
    "ciclo:  shr ax, 1           // bit uscito in CF",
    "        jnc zero",
    "        inc bx",
    "zero:   loop ciclo",
    "        stop"
  ],
  "data": []
}