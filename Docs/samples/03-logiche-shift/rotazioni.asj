{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// Rotazioni: ROL, ROR, RCL, RCR",
    "//",
    "// Cosa illustra:",
    "//   ROL e ROR fanno ruotare i bit: quelli che escono rientrano dall'altra",
    "//   parte (e vanno anche in CF). RCL e RCR ruotano attraverso CF, come se",
    "//   fosse un bit in più.",
    "//",
    "// Utilizzo:",
    "//   Eseguire con Step Into (formato Hex) e osservare AL, BL, CL, DL e CF.",
    "//",
    "// Risultato atteso:",
    "//   AX = 2341h, BL = 03h, CL = C0h, DL = 01h",
    "// ======================================================================",
    "",
    "        mov ax, 1234h",
    "        rol ax, 4           // 2341h",
    "        mov bx, 0",
    "        mov bl, 81h",
    "        rol bl, 1           // 03h, CF = 1",
    "        mov cx, 0",
    "        mov cl, 81h",
    "        ror cl, 1           // C0h, CF = 1",
    "        clc",
    "        mov dx, 0",
    "        mov dl, 80h",
    "        rcl dl, 1           // 00h: il bit 7 va in CF",
    "        rcl dl, 1           // 01h: CF rientra nel bit 0",
    "        stop"
  ],
  "data": []
}