{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// Somma degli elementi dispari di un vettore",
    "//",
    "// Cosa illustra:",
    "//   Ciclo su un vettore con indirizzamento indiretto, DIV per il test di",
    "//   parità (resto in DX) e salti condizionati.",
    "//   Memoria[0] = numero di elementi, memoria[1] = indirizzo del vettore.",
    "//   (riscrittura di Docs/Subroutines/somma dispari.as)",
    "//",
    "// Utilizzo:",
    "//   Aprire il file e premere Avvia; in alternativa eseguire con Step Into",
    "//   un'istruzione alla volta, osservando i pannelli Registri e Memoria.",
    "//",
    "// Risultato atteso:",
    "//   BX = 11 (1 + 3 + 7)",
    "// ======================================================================",
    "",
    "        mov bx, 0           // BX accumula la somma",
    "        mov cx, [0]         // numero degli elementi",
    "        mov si, [1]         // indirizzo del vettore",
    "",
    "ciclo:  cmp cx, 0           // il ciclo è finito?",
    "        je fine",
    "        mov ax, [si]        // preleva l'elemento",
    "        mov dx, 0           // DX:AX è il dividendo",
    "        div 2               // resto in DX",
    "        cmp dx, 0           // resto 0: numero pari",
    "        je pari",
    "        add bx, [si]        // somma l'elemento dispari",
    "pari:   inc si",
    "        dec cx",
    "        jmp ciclo",
    "",
    "fine:   stop"
  ],
  "data": [
    "0: 5",
    "1: 2",
    "2: 1, 3, 4, 6, 7"
  ]
}