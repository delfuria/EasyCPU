{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// Overflow a 8 bit",
    "//",
    "// Cosa illustra:",
    "//   127 + 1 esce dall'intervallo -128..127: OF = 1, SF = 1 (bit 7).",
    "//",
    "// Utilizzo:",
    "//   Aprire il file e premere Avvia; in alternativa eseguire con Step Into",
    "//   un'istruzione alla volta, osservando i pannelli Registri e Memoria.",
    "//",
    "// Risultato atteso:",
    "//   AX = 0080h (AL = -128)",
    "//   OF = 1, SF = 1, ZF = 0",
    "// ======================================================================",
    "",
    "        mov ax, 0",
    "        mov al, 127         // massimo valore a 8 bit con segno",
    "        add al, 1",
    "        stop"
  ],
  "data": []
}