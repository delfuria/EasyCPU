{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// Ciclo con LOOP",
    "//",
    "// Cosa illustra:",
    "//   LOOP decrementa CX e salta se CX non è zero: sostituisce la coppia",
    "//   DEC CX / JNZ. Non modifica i flag.",
    "//",
    "// Utilizzo:",
    "//   Aprire il file e premere Avvia; in alternativa eseguire con Step Into",
    "//   un'istruzione alla volta, osservando i pannelli Registri e Memoria.",
    "//",
    "// Risultato atteso:",
    "//   AX = 15 (5 + 4 + 3 + 2 + 1), CX = 0",
    "// ======================================================================",
    "",
    "        mov ax, 0",
    "        mov cx, 5",
    "ciclo:  add ax, cx",
    "        loop ciclo",
    "        stop"
  ],
  "data": []
}