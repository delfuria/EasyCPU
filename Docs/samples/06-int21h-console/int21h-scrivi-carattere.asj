{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// int 21h: scrittura di un carattere",
    "//",
    "// Cosa illustra:",
    "//   Servizio AH = 02h: scrive su console il carattere contenuto in DL.",
    "//",
    "// Utilizzo:",
    "//   Premere Avvia: il pannello Console si apre e mostra il testo.",
    "//",
    "// Risultato atteso:",
    "//   La console mostra: Ciao",
    "// ======================================================================",
    "",
    "        mov ah, 2           // servizio: scrivi carattere",
    "        mov dl, 'C'",
    "        int 21h",
    "        mov dl, 'i'",
    "        int 21h",
    "        mov dl, 'a'",
    "        int 21h",
    "        mov dl, 'o'",
    "        int 21h",
    "        stop"
  ],
  "data": []
}