{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// int 21h: lettura di una riga",
    "//",
    "// Cosa illustra:",
    "//   Servizio AH = 0Ah: legge una riga nel buffer puntato da DX.",
    "//   buf[0] = caratteri massimi (Invio compreso), buf[1] = caratteri letti,",
    "//   da buf[2] i caratteri. Il programma aggiunge '$' in fondo e ristampa",
    "//   la riga con il servizio 09h.",
    "//",
    "// Utilizzo:",
    "//   Premere Avvia, cliccare nel pannello Console, scrivere un nome e premere",
    "//   Invio (Backspace corregge l'ultimo carattere). Nel pannello Memoria",
    "//   la sezione Simboli mostra buf.",
    "//",
    "// Risultato atteso:",
    "//   Con il nome Mario la console mostra:",
    "//     Come ti chiami? Mario",
    "//     Ciao Mario",
    "// ======================================================================",
    "",
    "        mov ah, 9",
    "        mov dx, offset domanda",
    "        int 21h",
    "        mov ah, 0Ah         // servizio: leggi riga",
    "        mov dx, offset buf",
    "        int 21h",
    "        mov bl, buf+1       // numero di caratteri letti",
    "        mov bh, 0",
    "        mov si, bx",
    "        mov [buf+si+2], '$' // termina la stringa dopo l'ultimo carattere",
    "        mov ah, 9",
    "        mov dx, offset saluto",
    "        int 21h",
    "        mov dx, offset buf+2",
    "        int 21h",
    "        mov ah, 4Ch",
    "        int 21h"
  ],
  "data": [
    "buf     DB 20, ?, 20 DUP(?)     // al massimo 19 caratteri + Invio",
    "domanda DB 'Come ti chiami? $'",
    "saluto  DB 'Ciao $'"
  ]
}