{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// Tabella di salto: menu con jmp [tab+bx]",
    "//",
    "// Cosa illustra:",
    "//   Un'istruzione switch/case: invece di una catena di cmp/je, un solo",
    "//   salto attraverso la tabella tab, che contiene gli indirizzi (numeri",
    "//   d'istruzione) delle etichette caso0, caso1, caso2. Le etichette sono",
    "//   usate come valori nella sezione dati.",
    "//",
    "// Utilizzo:",
    "//   Premere Avvia, cliccare nel pannello Console e premere 0, 1 o 2.",
    "//   Nel pannello Memoria la sezione Simboli mostra tab e le etichette:",
    "//   le prime tre celle contengono i loro numeri d'istruzione.",
    "//",
    "// Risultato atteso:",
    "//   Con il tasto 1 la console mostra:",
    "//     Scelta (0, 1, 2)? 1",
    "//     uno",
    "//   Con un tasto diverso da 0, 1, 2 mostra \"scelta non valida\".",
    "// ======================================================================",
    "",
    "        mov ah, 9",
    "        mov dx, offset domanda",
    "        int 21h",
    "        mov ah, 1           // legge un tasto: AL = carattere",
    "        int 21h",
    "        sub al, '0'         // AL = 0, 1 o 2",
    "        cmp al, 2",
    "        ja errore           // senza segno: esclude anche i caratteri sotto '0'",
    "        mov bh, 0",
    "        mov bl, al          // BX = scelta: una cella per elemento della tabella",
    "        jmp [tab+bx]        // salta all'indirizzo contenuto in tab+BX",
    "",
    "caso0:  mov dx, offset msg0",
    "        jmp stampa",
    "caso1:  mov dx, offset msg1",
    "        jmp stampa",
    "caso2:  mov dx, offset msg2",
    "        jmp stampa",
    "errore: mov dx, offset errato",
    "",
    "stampa: mov ah, 9",
    "        int 21h",
    "        mov ah, 4Ch",
    "        int 21h"
  ],
  "data": [
    "tab     DW caso0, caso1, caso2      ; tabella di salto",
    "domanda DB 'Scelta (0, 1, 2)? $'",
    "msg0    DB 13, 10, 'zero$'",
    "msg1    DB 13, 10, 'uno$'",
    "msg2    DB 13, 10, 'due$'",
    "errato  DB 13, 10, 'scelta non valida$'"
  ]
}