{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// Tabella di procedure: call [proc+si]",
    "//",
    "// Cosa illustra:",
    "//   Un puntatore a funzione: la tabella proc contiene gli indirizzi di tre",
    "//   procedure (somma, differenza, prodotto); il ciclo le chiama una dopo",
    "//   l'altra con call [proc+si] sugli stessi operandi e salva i risultati.",
    "//   Il ritorno con ret funziona come per una call diretta.",
    "//",
    "// Utilizzo:",
    "//   Eseguire con Step Into e osservare IP dopo call [proc+si]: vale il",
    "//   numero d'istruzione letto dalla tabella. Step Over esegue invece",
    "//   l'intera procedura.",
    "//",
    "// Risultato atteso:",
    "//   ris = 17, 7, 60 (12 + 5, 12 - 5, 12 * 5); SP = 256",
    "// ======================================================================",
    "",
    "        mov si, 0           // indice nella tabella delle procedure",
    "        mov di, offset ris  // dove salvare i risultati",
    "        mov cx, 3",
    "ciclo:  mov ax, 12",
    "        mov bx, 5",
    "        call [proc+si]      // chiama la procedura il cui indirizzo è in proc+SI",
    "        mov [di], ax",
    "        inc si",
    "        inc di",
    "        loop ciclo",
    "        stop",
    "",
    "// procedure: operandi in AX e BX, risultato in AX",
    "somma:      add ax, bx",
    "            ret",
    "differenza: sub ax, bx",
    "            ret",
    "prodotto:   mul bx          // DX:AX = AX * BX",
    "            ret"
  ],
  "data": [
    "proc    DW somma, differenza, prodotto  ; tabella delle procedure",
    "ris     DW 3 DUP(?)"
  ]
}