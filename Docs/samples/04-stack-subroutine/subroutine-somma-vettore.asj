{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// Subroutine SommaVettore(vet)",
    "//",
    "// Cosa illustra:",
    "//   Subroutine che riceve sullo stack l'indirizzo di un vettore (il primo",
    "//   elemento è la lunghezza) e restituisce in AX la somma degli elementi;",
    "//   salva e ripristina i registri che usa. Ciclo con JCXZ.",
    "//   Equivale a: int SommaVettore(int[] vet) { ... }",
    "//   (riscrittura di Docs/Subroutines/Sub Somma vettore.as)",
    "//",
    "// Utilizzo:",
    "//   Eseguire con Step Into per seguire il ciclo; osservare il pannello Stack.",
    "//",
    "// Risultato atteso:",
    "//   AX = 10 (2 + 3 + 4 + 1)",
    "//   SP = 256",
    "// ======================================================================",
    "",
    "        push 10             // indirizzo del vettore",
    "        call sommaVet",
    "        add sp, 1           // rimuove il parametro",
    "        stop",
    "",
    "sommaVet:",
    "        push bp             // salva BP",
    "        mov bp, sp",
    "        push cx",
    "        push si",
    "        mov si, [bp+2]      // [bp+2] = indirizzo del vettore",
    "        mov ax, 0",
    "        mov cx, [si]        // CX = lunghezza",
    "inizioCiclo:",
    "        jcxz fineCiclo",
    "        inc si",
    "        add ax, [si]",
    "        dec cx",
    "        jmp inizioCiclo",
    "fineCiclo:",
    "        pop si",
    "        pop cx",
    "        pop bp",
    "        ret"
  ],
  "data": [
    "10: 4, 2, 3, 4, 1"
  ]
}