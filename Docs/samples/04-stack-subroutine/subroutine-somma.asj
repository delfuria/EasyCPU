{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// Subroutine Somma(a, b)",
    "//",
    "// Cosa illustra:",
    "//   Subroutine con due parametri passati sullo stack, frame con BP e",
    "//   risultato in AX; il chiamante ripulisce lo stack dopo ogni CALL.",
    "//   Equivale a: int Somma(int a, int b) { return a + b; }",
    "//   (riscrittura di Docs/Subroutines/Sub Somma.as; aggiunto add sp,2",
    "//   dopo ogni chiamata)",
    "//",
    "// Utilizzo:",
    "//   Eseguire con Step Over sulle CALL, oppure Step Into per seguire",
    "//   la subroutine; osservare il pannello Stack.",
    "//",
    "// Risultato atteso:",
    "//   AX = 32 (4 + 5 = 9, 9 + 11 = 20, 20 + 12 = 32)",
    "//   SP = 256",
    "// ======================================================================",
    "",
    "        push [1]            // a",
    "        push [2]            // b",
    "        call somma          // AX = a + b",
    "        add sp, 2           // rimuove i parametri",
    "",
    "        push ax",
    "        push [10]",
    "        call somma",
    "        add sp, 2",
    "",
    "        push ax",
    "        push [15]",
    "        call somma",
    "        add sp, 2",
    "        stop",
    "",
    "somma:  push bp             // salva BP",
    "        mov bp, sp",
    "        mov ax, [bp+2]      // [bp+2] = b",
    "        add ax, [bp+3]      // [bp+3] = a",
    "        pop bp",
    "        ret"
  ],
  "data": [
    "1: 4, 5",
    "10: 11",
    "15: 12"
  ]
}