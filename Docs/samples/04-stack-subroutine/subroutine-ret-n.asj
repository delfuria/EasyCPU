{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// Subroutine con RET n",
    "//",
    "// Cosa illustra:",
    "//   RET n torna al chiamante e rimuove n parametri dallo stack: la pulizia",
    "//   la fa la subroutine (convenzione Pascal/stdcall) invece del chiamante.",
    "//",
    "// Utilizzo:",
    "//   Eseguire con Step Into e osservare SP nel pannello Stack prima della",
    "//   CALL e dopo il RET.",
    "//",
    "// Risultato atteso:",
    "//   AX = 32 (4 + 5 = 9, 9 + 11 = 20, 20 + 12 = 32)",
    "//   SP = 256 senza add sp dopo le CALL",
    "// ======================================================================",
    "",
    "        push a",
    "        push b",
    "        call somma          // AX = a + b",
    "        push ax",
    "        push c",
    "        call somma",
    "        push ax",
    "        push d",
    "        call somma",
    "        stop",
    "",
    "somma:  push bp",
    "        mov bp, sp",
    "        mov ax, [bp+2]      // secondo parametro",
    "        add ax, [bp+3]      // primo parametro",
    "        pop bp",
    "        ret 2               // rimuove i due parametri"
  ],
  "data": [
    "a       DW 4",
    "b       DW 5",
    "c       DW 11",
    "d       DW 12"
  ]
}