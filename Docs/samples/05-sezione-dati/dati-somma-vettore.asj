{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// Somma di un vettore con nomi simbolici",
    "//",
    "// Cosa illustra:",
    "//   Ciclo su un vettore con [vet+si] e lunghezza da una costante EQU.",
    "//   Le celle sono di 16 bit: l'elemento successivo è a SI + 1.",
    "//",
    "// Utilizzo:",
    "//   Aprire il file e premere Avvia; in alternativa eseguire con Step Into",
    "//   un'istruzione alla volta, osservando i pannelli Registri e Memoria.",
    "//",
    "// Risultato atteso:",
    "//   AX = 25",
    "//   somma (indirizzo 5) = 25",
    "// ======================================================================",
    "",
    "        mov ax, 0",
    "        mov si, 0",
    "        mov cx, N",
    "ciclo:  add ax, [vet+si]",
    "        inc si",
    "        dec cx",
    "        jne ciclo",
    "        mov somma, ax",
    "        stop"
  ],
  "data": [
    "N       EQU 5",
    "vet     DW 3, 8, 1, 9, 4",
    "somma   DW ?"
  ]
}