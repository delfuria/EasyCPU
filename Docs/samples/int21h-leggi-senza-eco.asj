{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// int 21h: lettura senza eco",
    "//",
    "// Cosa illustra:",
    "//   Servizio AX = 7: legge un tasto senza mostrarlo; il programma lo",
    "//   trasforma in maiuscolo e lo stampa con il servizio AX = 2.",
    "//",
    "// Utilizzo:",
    "//   Premere Avvia, cliccare nel pannello Console e premere una lettera minuscola.",
    "//",
    "// Risultato atteso:",
    "//   La console mostra la lettera maiuscola; DX = codice della maiuscola",
    "// ======================================================================",
    "",
    "        mov ax, 7           // servizio: leggi carattere senza eco",
    "        int 21h",
    "        sub ax, 32          // 'a' - 'A' = 32",
    "        mov dx, ax",
    "        mov ax, 2           // servizio: scrivi carattere",
    "        int 21h",
    "        stop"
  ],
  "data": []
}