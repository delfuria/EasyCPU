{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// Trasferimento memoria-memoria con MOVS",
    "//",
    "// Cosa illustra:",
    "//   MOVS copia la cella puntata da SI nella cella puntata da DI.",
    "//",
    "// Utilizzo:",
    "//   Aprire il file e premere Avvia; in alternativa eseguire con Step Into",
    "//   un'istruzione alla volta, osservando i pannelli Registri e Memoria.",
    "//",
    "// Risultato atteso:",
    "//   Memoria[2] = 77",
    "//   AX = 77",
    "// ======================================================================",
    "",
    "        mov si, 1           // sorgente",
    "        mov di, 2           // destinazione",
    "        movs                // memoria[2] = memoria[1]",
    "        mov ax, [2]",
    "        stop"
  ],
  "data": [
    "1: 77"
  ]
}