{
  "version": 1,
  "memoria": "byte",
  "code": [
    "// ======================================================================",
    "// Memoria a byte: tabella di salto",
    "//",
    "// Cosa illustra:",
    "//   Gli elementi di una tabella DW occupano due byte: l'indice va",
    "//   moltiplicato per 2 (shl bx, 1) prima di jmp [tab+bx].",
    "//   Il file attiva la memoria a byte (menu Esegui, «Memoria a byte (x86)»):",
    "//   512 byte, parole little-endian, stack nei byte 448..511.",
    "//",
    "// Utilizzo:",
    "//   Eseguire con Step Into; cambiare il valore di scelta (0, 1 o 2) nella",
    "//   sezione dati e ripetere.",
    "//",
    "// Risultato atteso:",
    "//   AX = 300 (scelta = 2)",
    "// ======================================================================",
    "",
    "        mov bl, scelta",
    "        mov bh, 0",
    "        shl bx, 1           // due byte per elemento",
    "        jmp [tab+bx]",
    "caso0:  mov ax, 100",
    "        jmp fine",
    "caso1:  mov ax, 200",
    "        jmp fine",
    "caso2:  mov ax, 300",
    "fine:   stop"
  ],
  "data": [
    "tab     DW caso0, caso1, caso2",
    "scelta  DB 2"
  ]
}