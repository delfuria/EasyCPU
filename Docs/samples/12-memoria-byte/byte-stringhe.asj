{
  "version": 1,
  "memoria": "byte",
  "code": [
    "// ======================================================================",
    "// Memoria a byte: istruzioni stringa",
    "//",
    "// Cosa illustra:",
    "//   movsb avanza SI e DI di un byte, movsw di due: nella memoria a byte le",
    "//   due forme copiano quantità diverse. La stringa copiata viene stampata",
    "//   con int 21h, servizio 09h.",
    "//   Il file attiva la memoria a byte (menu Esegui, «Memoria a byte (x86)»):",
    "//   512 byte, parole little-endian, stack nei byte 448..511.",
    "//",
    "// Utilizzo:",
    "//   Premere Avvia e guardare il pannello Console; nel pannello Memoria (byte)",
    "//   confrontare msg con copia e vet con vet2.",
    "//",
    "// Risultato atteso:",
    "//   La console mostra: Ciao!",
    "//   vet2 = 1, 2, 3; SI = 18, DI = 24",
    "// ======================================================================",
    "",
    "        cld",
    "        mov si, offset msg",
    "        mov di, offset copia",
    "        mov cx, 6           // 6 byte, '$' compreso",
    "        rep movsb",
    "        mov si, offset vet",
    "        mov di, offset vet2",
    "        mov cx, 3           // 3 parole = 6 byte",
    "        rep movsw",
    "        mov ah, 9",
    "        mov dx, offset copia",
    "        int 21h",
    "        stop"
  ],
  "data": [
    "msg     DB 'Ciao!$'",
    "copia   DB 6 DUP(?)",
    "vet     DW 1, 2, 3",
    "vet2    DW 3 DUP(0)"
  ]
}