{
  "version": 1,
  "memoria": "byte",
  "code": [
    "// ======================================================================",
    "// Memoria a byte: parametri sullo stack",
    "//",
    "// Cosa illustra:",
    "//   Ogni push occupa due byte: dopo push bp e mov bp, sp l'indirizzo di",
    "//   ritorno è in [bp+2] e i parametri in [bp+4], [bp+6]. ret 4 rimuove i due",
    "//   parametri: il valore di ret è in byte, come su x86.",
    "//   Il file attiva la memoria a byte (menu Esegui, «Memoria a byte (x86)»):",
    "//   512 byte, parole little-endian, stack nei byte 448..511.",
    "//",
    "// Utilizzo:",
    "//   Eseguire con Step Into osservando SP, BP e il pannello Stack.",
    "//",
    "// Risultato atteso:",
    "//   AX = 12 (7 + 5), SP = 512",
    "// ======================================================================",
    "",
    "        mov ax, 5",
    "        push ax             // primo parametro",
    "        mov ax, 7",
    "        push ax             // secondo parametro",
    "        call somma",
    "        stop",
    "",
    "somma:  push bp",
    "        mov bp, sp",
    "        mov ax, [bp+4]      // ultimo parametro inserito",
    "        add ax, [bp+6]",
    "        pop bp",
    "        ret 4               // rimuove due parole: 4 byte"
  ],
  "data": []
}