{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// Riempimento con REP STOSW",
    "//",
    "// Cosa illustra:",
    "//   REP STOSW scrive AX in CX celle consecutive a partire da DI.",
    "//",
    "// Utilizzo:",
    "//   Aprire il file e premere Avvia; in alternativa eseguire con Step Into",
    "//   un'istruzione alla volta, osservando i pannelli Registri e Memoria.",
    "//",
    "// Risultato atteso:",
    "//   tab = 7 in tutte le 8 celle (indirizzi 0..7)",
    "//   DI = 8, CX = 0",
    "// ======================================================================",
    "",
    "        cld",
    "        mov ax, 7",
    "        mov di, offset tab",
    "        mov cx, 8",
    "        rep stosw",
    "        stop"
  ],
  "data": [
    "tab     DW 8 DUP(?)"
  ]
}