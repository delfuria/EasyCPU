{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// Lunghezza di una stringa con REPNE SCASB",
    "//",
    "// Cosa illustra:",
    "//   SCASB confronta AL con il carattere puntato da DI; REPNE lo ripete",
    "//   finché i caratteri sono diversi e CX non è zero. Cercando '$' si",
    "//   ottiene la lunghezza della stringa: caratteri esaminati meno uno.",
    "//",
    "// Utilizzo:",
    "//   Aprire il file e premere Avvia; in alternativa eseguire con Step Into",
    "//   un'istruzione alla volta, osservando i pannelli Registri e Memoria.",
    "//",
    "// Risultato atteso:",
    "//   BX = 10 (lunghezza di 'ciao mondo')",
    "//   Subito dopo REPNE SCASB: ZF = 1 ('$' trovato), CX = 89",
    "// ======================================================================",
    "",
    "        cld",
    "        mov di, offset msg",
    "        mov al, '$'",
    "        mov cx, MAX",
    "        repne scasb         // cerca '$'",
    "        mov bx, MAX",
    "        sub bx, cx          // caratteri esaminati, '$' compreso",
    "        dec bx              // lunghezza senza '$'",
    "        stop"
  ],
  "data": [
    "MAX     EQU 100",
    "msg     DB 'ciao mondo$'"
  ]
}