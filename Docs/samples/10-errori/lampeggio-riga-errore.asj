{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// Riga dell'errore evidenziata con un lampeggio",
    "//",
    "// Cosa illustra:",
    "//   Con un doppio click su un errore del pannello Errori, l'editor (Codice",
    "//   o Dati) scorre fino alla riga dell'errore, vi porta il cursore e la fa",
    "//   lampeggiare brevemente (due impulsi rosso/arancio), per ritrovarla",
    "//   subito anche in un programma lungo.",
    "//",
    "// Utilizzo:",
    "//   Compilare. Nel pannello Errori fare doppio click sull'errore di Codice",
    "//   (riga 37, fuori dalla parte visibile se la finestra è piccola), poi",
    "//   su quello di Dati (riga 3).",
    "//",
    "// Risultato atteso:",
    "//   Due errori: Codice riga 37 (movv non è un'istruzione),",
    "//   Dati riga 3 (DX non è una direttiva)",
    "// ======================================================================",
    "",
    "        mov cx, 5",
    "        mov ax, 0",
    "ciclo:  add ax, cx",
    "        loop ciclo          // AX = 5+4+3+2+1 = 15",
    "        mov somma, ax",
    "",
    "        mov bx, 1",
    "        mov cx, 4",
    "potenza:",
    "        shl bx, 1",
    "        loop potenza        // BX = 16",
    "        mov risultato, bx",
    "",
    "        mov ax, somma",
    "        add ax, risultato   // 31",
    "",
    "        // errore voluto: istruzione inesistente",
    "        movv dx, ax",
    "        stop"
  ],
  "data": [
    "somma      DW 0",
    "risultato  DW 0",
    "errore     DX 0          // errore voluto: direttiva inesistente"
  ]
}
