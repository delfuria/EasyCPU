{
  "version": 1,
  "code": [
    "// ======================================================================",
    "// Costanti a 8 bit senza segno",
    "//",
    "// Cosa illustra:",
    "//   Una costante da 128 a 255 usata a 8 bit equivale al valore negativo",
    "//   corrispondente: 200 = C8h = -56.",
    "//",
    "// Utilizzo:",
    "//   Aprire il file e premere Avvia; in alternativa eseguire con Step Into",
    "//   un'istruzione alla volta, osservando i pannelli Registri e Memoria.",
    "//",
    "// Risultato atteso:",
    "//   AX = 66 (10 - (-56))",
    "//   OF = 0",
    "// ======================================================================",
    "",
    "        mov ax, 0",
    "        mov al, 10",
    "        sub al, 200         // 200 a 8 bit vale -56",
    "        stop"
  ],
  "data": []
}