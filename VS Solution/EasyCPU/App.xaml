<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EasyCPU"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="EasyCPU.App"
             Name="EasyCPU">
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="Informazioni su EasyCPU..." Click="OnAboutClick"/>
        </NativeMenu>
    </NativeMenu.Menu>
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>
    <Application.Resources>
        <ResourceDictionary>
            <!-- sfondo dei valori cambiati nei pannelli Registri, Memoria e Stack -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SfondoValoreCambiato" Color="#FFE680" />
                    <SolidColorBrush x:Key="TestoValoreCambiato" Color="#1C1F23" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <!-- sfondo chiaro anche nel tema scuro, per risaltare: il testo diventa scuro -->
                    <SolidColorBrush x:Key="SfondoValoreCambiato" Color="#FFD54F" />
                    <SolidColorBrush x:Key="TestoValoreCambiato" Color="#1C1F23" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <semi:SemiTheme Locale="it-IT" />
        <semi:AvaloniaEditSemiTheme />
        <semi:ProDataGridSemiTheme />
        <semi:DockSemiTheme />
        <!-- pulsanti della barra strumenti senza sfondo, come nelle IDE moderne -->
        <Style Selector="StackPanel.toolbar > Button">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
        </Style>
        <Style Selector="Run.cambiato">
            <Setter Property="Background" Value="{DynamicResource SfondoValoreCambiato}" />
            <Setter Property="Foreground" Value="{DynamicResource TestoValoreCambiato}" />
        </Style>
    </Application.Styles>
</Application>
