<?xml version="1.0" encoding="utf-8"?>
<SyntaxDefinition name="EasyCPU" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">

  <Color name="Comment"    foreground="#008000" />
  <Color name="Register"   foreground="#007070" />
  <Color name="Indirect"   foreground="#2B91AF" />
  <Color name="Directive"  foreground="#800080" fontWeight="bold" />
  <Color name="Number"     foreground="#098658" />
  <Color name="CharConst"  foreground="#A31515" />
  <Color name="Label"      foreground="#795E26" />

  <!-- Opcode per categoria -->
  <Color name="OpcodeMove"  foreground="#1565C0" fontWeight="bold" />  <!-- mov movs         — blu -->
  <Color name="OpcodeArith" foreground="#5D2906" fontWeight="bold" />  <!-- add sub mul div… — marrone scuro -->
  <Color name="OpcodeLogic" foreground="#0F766E" fontWeight="bold" />  <!-- and or xor not… — teal -->
  <Color name="OpcodeCmp"   foreground="#AD1457" fontWeight="bold" />  <!-- cmp              — rosa scuro -->
  <Color name="OpcodeStack" foreground="#4527A0" fontWeight="bold" />  <!-- push pop…        — indaco -->
  <Color name="OpcodeJump"  foreground="#C62828" fontWeight="bold" />  <!-- jmp j* call ret  — rosso -->
  <Color name="OpcodeMisc"  foreground="#546E7A" fontWeight="bold" />  <!-- nop stop         — grigio-blu -->
  <Color name="OpcodeInterrupt" foreground="#8BC34A" fontWeight="bold" />  <!-- int              — verde chiaro -->

  <!-- Tema scuro: "Dark.X" sostituisce il colore "X" (gli attributi assenti restano quelli chiari).
       Non usati dalle regole: li applica App.RegisterEasyCpuHighlighting. -->
  <Color name="Dark.Comment"    foreground="#C5E1A5" />
  <Color name="Dark.Register"   foreground="#4EC9B0" />
  <Color name="Dark.Indirect"   foreground="#9CDCFE" />
  <Color name="Dark.Directive"  foreground="#C586C0" />
  <Color name="Dark.Number"     foreground="#B5CEA8" />
  <Color name="Dark.CharConst"  foreground="#CE9178" />
  <Color name="Dark.Label"      foreground="#DCDCAA" />

  <Color name="Dark.OpcodeMove"  foreground="#64B5F6" />  <!-- blu chiaro -->
  <Color name="Dark.OpcodeArith" foreground="#FFB74D" />  <!-- arancio -->
  <Color name="Dark.OpcodeLogic" foreground="#4DD0E1" />  <!-- ciano -->
  <Color name="Dark.OpcodeCmp"   foreground="#F48FB1" />  <!-- rosa -->
  <Color name="Dark.OpcodeStack" foreground="#B39DDB" />  <!-- lavanda -->
  <Color name="Dark.OpcodeJump"  foreground="#FF6E6E" />  <!-- rosso chiaro -->
  <Color name="Dark.OpcodeMisc"  foreground="#B0BEC5" />  <!-- grigio-blu chiaro -->
  <Color name="Dark.OpcodeInterrupt" foreground="#C5E1A5" />  <!-- verde chiaro -->

  <RuleSet ignoreCase="true">

    <!-- Commenti: // oppure ; fino a fine riga -->
    <Span color="Comment" multiline="false">
      <Begin>//</Begin>
    </Span>
    <Span color="Comment" multiline="false">
      <Begin>;</Begin>
    </Span>

    <!-- Costanti carattere: 'c' -->
    <Span color="CharConst" multiline="false">
      <Begin>'</Begin>
      <End>'</End>
    </Span>

    <!-- Indirizzamento indiretto: [bx], [bp+n], [si-n], [di] -->
    <Span color="Indirect" multiline="false">
      <Begin>\[</Begin>
      <End>\]</End>
    </Span>

    <!-- Marcatore sezione dati -->
    <Rule color="Directive">\.DATA\b</Rule>

    <!-- byte ptr / word ptr: solo nella forma completa, byte e word da soli possono essere nomi -->
    <Rule color="Directive">\b(byte|word)\s+ptr\b</Rule>

    <!-- Direttive della sezione dati e operatore offset -->
    <Keywords color="Directive">
      <Word>db</Word>
      <Word>dw</Word>
      <Word>equ</Word>
      <Word>dup</Word>
      <Word>org</Word>
      <Word>offset</Word>
    </Keywords>

    <!-- Movimento dati -->
    <Keywords color="OpcodeMove">
      <Word>mov</Word>
      <Word>movs</Word>
      <Word>xchg</Word>
      <Word>lea</Word>
      <Word>movsb</Word>
      <Word>movsw</Word>
      <Word>lodsb</Word>
      <Word>lodsw</Word>
      <Word>stosb</Word>
      <Word>stosw</Word>
      <Word>cmpsb</Word>
      <Word>cmpsw</Word>
      <Word>scasb</Word>
      <Word>scasw</Word>
      <Word>rep</Word>
      <Word>repe</Word>
      <Word>repz</Word>
      <Word>repne</Word>
      <Word>repnz</Word>
    </Keywords>

    <!-- Aritmetica -->
    <Keywords color="OpcodeArith">
      <Word>add</Word>
      <Word>sub</Word>
      <Word>mul</Word>
      <Word>div</Word>
      <Word>inc</Word>
      <Word>dec</Word>
      <Word>neg</Word>
      <Word>adc</Word>
      <Word>sbb</Word>
      <Word>imul</Word>
      <Word>idiv</Word>
      <Word>cbw</Word>
      <Word>cwd</Word>
    </Keywords>

    <!-- Logica e shift -->
    <Keywords color="OpcodeLogic">
      <Word>and</Word>
      <Word>or</Word>
      <Word>xor</Word>
      <Word>not</Word>
      <Word>shl</Word>
      <Word>shr</Word>
      <Word>test</Word>
      <Word>sar</Word>
      <Word>rol</Word>
      <Word>ror</Word>
      <Word>rcl</Word>
      <Word>rcr</Word>
    </Keywords>

    <!-- Confronto -->
    <Keywords color="OpcodeCmp">
      <Word>cmp</Word>
      <Word>clc</Word>
      <Word>stc</Word>
      <Word>cmc</Word>
      <Word>cld</Word>
      <Word>std</Word>
    </Keywords>

    <!-- Stack -->
    <Keywords color="OpcodeStack">
      <Word>push</Word>
      <Word>pop</Word>
      <Word>pushf</Word>
      <Word>popf</Word>
    </Keywords>

    <!-- Salti, chiamate e ritorno -->
    <Keywords color="OpcodeJump">
      <Word>jmp</Word>
      <Word>je</Word>
      <Word>jne</Word>
      <Word>jg</Word>
      <Word>jl</Word>
      <Word>jge</Word>
      <Word>jle</Word>
      <Word>jo</Word>
      <Word>jno</Word>
      <Word>js</Word>
      <Word>jns</Word>
      <Word>jcxz</Word>
      <Word>ja</Word>
      <Word>jae</Word>
      <Word>jb</Word>
      <Word>jbe</Word>
      <Word>jc</Word>
      <Word>jnc</Word>
      <Word>jz</Word>
      <Word>jnz</Word>
      <Word>jna</Word>
      <Word>jnae</Word>
      <Word>jnb</Word>
      <Word>jnbe</Word>
      <Word>jng</Word>
      <Word>jnge</Word>
      <Word>jnl</Word>
      <Word>jnle</Word>
      <Word>loop</Word>
      <Word>loope</Word>
      <Word>loopz</Word>
      <Word>loopne</Word>
      <Word>loopnz</Word>
      <Word>call</Word>
      <Word>ret</Word>
    </Keywords>

    <!-- Varie -->
    <Keywords color="OpcodeMisc">
      <Word>nop</Word>
      <Word>stop</Word>
    </Keywords>

    <!-- Interrupt -->
    <Keywords color="OpcodeInterrupt">
      <Word>int</Word>
    </Keywords>

    <!-- Registri -->
    <Keywords color="Register">
      <Word>ax</Word>
      <Word>bx</Word>
      <Word>cx</Word>
      <Word>dx</Word>
      <Word>si</Word>
      <Word>di</Word>
      <Word>bp</Word>
      <Word>sp</Word>
      <Word>ip</Word>
      <Word>al</Word>
      <Word>ah</Word>
      <Word>bl</Word>
      <Word>bh</Word>
      <Word>cl</Word>
      <Word>ch</Word>
      <Word>dl</Word>
      <Word>dh</Word>
    </Keywords>

    <!-- Numeri esadecimali con suffisso h: es. 1Ah, 0FFh -->
    <Rule color="Number">\b[0-9][0-9a-fA-F]*h\b</Rule>

    <!-- Numeri decimali -->
    <Rule color="Number">\b[0-9]+\b</Rule>

    <!-- Definizione etichetta: nome: -->
    <Rule color="Label">\b[a-zA-Z_]\w*(?=\s*:)</Rule>

  </RuleSet>

</SyntaxDefinition>
