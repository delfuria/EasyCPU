<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox:
         NON utilizzato per la distribuzione diretta tramite Developer ID + DMG.
         È richiesto per le app distribuite tramite Mac App Store.
         L'abilitazione del Sandbox con Avalonia può interferire con
         NSApplication/LaunchServices durante l'avvio. -->

    <!-- Connessioni di rete in uscita (EasyCpu.Backend) -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Hardened Runtime: il runtime .NET richiede compilazione JIT -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Hardened Runtime: il runtime .NET scrive in memoria eseguibile -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Hardened Runtime: senza questa entitlement dyld rifiuta di caricare dylib di terze
         parti bundlate nell'app sotto alcuni profili di provisioning del Mac App Store/TestFlight -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
